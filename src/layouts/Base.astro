---
// Original Divi header/footer/CSS, generated from the Wayback capture by scripts/convert-archive.mjs.
import headerRaw from '../divi/header.html?raw';
import footerRaw from '../divi/footer.html?raw';
import bodyClassRaw from '../divi/body-class.txt?raw';

interface Props { title?: string }
const { title } = Astro.props;
const pageTitle = title ? `${title} | Test Lab CDO` : 'Test Lab CDO | Engineering & Geotech';
const path = Astro.url.pathname;
const isHome = path === '/';

// The archived header marks Home as current; move that marker to this page's link.
let header = headerRaw;
if (!isHome) {
  header = header
    .replace(/ current-menu-item| current_page_item| page_item page-item-24/g, '')
    .replace(' aria-current="page"', '')
    .replace(`<a href="${path}">`, `<a href="${path}" aria-current="page">`);
}
const bodyClass = isHome ? bodyClassRaw.trim() : bodyClassRaw.trim().replace(/\bhome\b|\bpage-id-24\b/g, '');
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />
  <title>{pageTitle}</title>
  <link rel="icon" href="/images/cropped-testlab_icon-1-32x32.png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/images/cropped-testlab_icon-1-180x180.png" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Open+Sans:300italic,400italic,600italic,700italic,800italic,400,300,600,700,800&subset=latin,latin-ext&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Rubik:300,regular,500,600,700,800,900,300italic,italic,500italic,600italic,700italic,800italic,900italic|Adamina:regular|Arimo:regular,500,600,700,italic,500italic,600italic,700italic&subset=latin,latin-ext&display=swap" />
  <link rel="stylesheet" href="/divi/site.css" />
  <link rel="stylesheet" href="/site.css" />
</head>
<body class={bodyClass}>
  <div id="page-container">
    <div id="et-boc" class="et-boc">
      <Fragment set:html={header} />
      <div id="et-main-area">
        <div id="main-content"><slot /></div>
        <Fragment set:html={footerRaw} />
      </div>
    </div>
  </div>
  <script is:inline>
    // Divi's jQuery menu script replaced: copy the desktop menu into the mobile dropdown and toggle it.
    document.querySelectorAll('.et_pb_menu').forEach((menu) => {
      const bar = menu.querySelector('.mobile_menu_bar');
      const nav = menu.querySelector('.mobile_nav');
      const src = menu.querySelector('.et-menu');
      if (!bar || !nav || !src) return;
      const list = src.cloneNode(true);
      list.removeAttribute('id');
      list.className = 'et_mobile_menu';
      list.style.display = 'none';
      nav.appendChild(list);
      bar.setAttribute('role', 'button');
      bar.setAttribute('tabindex', '0');
      bar.setAttribute('aria-label', 'Menu');
      const toggle = () => {
        const open = nav.classList.toggle('opened');
        nav.classList.toggle('closed', !open);
        list.style.display = open ? 'block' : 'none';
      };
      bar.addEventListener('click', toggle);
      bar.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } });
    });
  </script>
</body>
</html>
