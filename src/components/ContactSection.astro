<section class="contact" id="contact">
  <div class="contact-form-col">
    <h2 class="heading">Contact Us</h2>
    <span class="bar bar-dark"></span>
    <!-- shortcut: the old Divi form posted to WordPress; mailto opens the visitor's mail app. Swap for Formspree/Netlify Forms once hosting is chosen. -->
    <form action="mailto:testlabcdo@gmail.com" method="post" enctype="text/plain">
      <div class="row-2">
        <label><span class="sr-only">Name</span><input name="name" placeholder="Name" required /></label>
        <label><span class="sr-only">Email Address</span><input name="email" type="email" placeholder="Email Address" required /></label>
      </div>
      <label><span class="sr-only">Message</span><textarea name="message" rows="5" placeholder="Message" required></textarea></label>
      <button type="submit" class="btn-outline">Send Message</button>
    </form>
  </div>
  <div class="contact-info-col">
    <div class="follow">
      <a href="https://www.facebook.com/APBTestLab" target="_blank" rel="noopener" aria-label="Follow us on Facebook">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M14 8V6c0-.9.6-1.1 1-1.1h2.6V1h-3.6C10.1 1 9.3 3.9 9.3 5.8V8H7v4h2.3v11H14V12h3.1l.4-4H14z"/></svg>
      </a>
    </div>
    <ul class="info">
      <li>
        <span class="ico" aria-hidden="true">📍</span>
        <div><strong>Office Address:</strong><p>You We Tong Building, Gusa Highway Cagayan de Oro City</p></div>
      </li>
      <li>
        <span class="ico" aria-hidden="true">📞</span>
        <div><strong>Mobile No.</strong>
          <p><a href="tel:+639676675017">+63 09676675017 (Office)</a></p>
          <p><a href="tel:+639177048964">+63 09177048964 (Lab)</a></p>
          <p><a href="tel:+639518786082">+63 09518786082 (Smart)</a></p>
        </div>
      </li>
      <li>
        <span class="ico" aria-hidden="true">✉️</span>
        <div><strong>Company Emails:</strong>
          <p><a href="mailto:testlabcdo@gmail.com">testlabcdo@gmail.com</a></p>
          <p><a href="mailto:acct.testlabcdo@gmail.com">acct.testlabcdo@gmail.com</a></p>
        </div>
      </li>
    </ul>
  </div>
</section>
